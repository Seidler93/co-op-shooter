# BUT KEEP THESE (important!)
!game/Assets/**/*.meta
!game/Packages/**/*.json
!game/ProjectSettings/**/*.asset

# Locally installed Unity Asset Store/source packs. Keep project-owned prefabs,
# scenes, scripts, and selected runtime assets under Assets/_Project instead.
game/**/Assets/ThirdParty/ADG_Textures/
game/**/Assets/ThirdParty/ADG_Textures.meta
game/**/Assets/ThirdParty/Flooded_Grounds/
game/**/Assets/ThirdParty/Flooded_Grounds.meta
game/**/Assets/ThirdParty/Rifle_27A2_Starter/
game/**/Assets/ThirdParty/Rifle_27A2_Starter.meta
game/**/Assets/ThirdParty/TextureHaven/
game/**/Assets/ThirdParty/TextureHaven.meta
game/**/Assets/ThirdParty/Zombie 1/
game/**/Assets/ThirdParty/Zombie 1.meta
game/**/Assets/ThirdParty/ammo_box/
game/**/Assets/ThirdParty/ammo_box.meta

# Large source texture/model pack; local import only. Copy optimized runtime
# derivatives into Assets/_Project when the game actually needs them.
game/**/Assets/Ditag Design/
game/**/Assets/Ditag Design.meta

